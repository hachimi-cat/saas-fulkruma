# Backend config — copy to .env

# Your service identity (must match the service name in @forjio/sdk)
FORJIO_SERVICE=fulkruma

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fulkruma

# Huudis OIDC — set after the product is registered as an OAuth client
HUUDIS_ISSUER=https://huudis.com
HUUDIS_AUDIENCE=fulkruma

# HTTP
PORT=4140
NODE_ENV=development

# Outbox worker
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# Merchant webhooks (services/webhook-delivery.ts). All optional; the
# defaults are what the docs promise (10 s timeout; an endpoint is
# switched off after 20 failed attempts in a row over at least 24 h).
# WEBHOOK_POLL_INTERVAL_MS=1000
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_DELIVERY_CONCURRENCY=5
# WEBHOOK_DELIVERY_BATCH=50
# WEBHOOK_DISABLE_AFTER_FAILURES=20
# WEBHOOK_DISABLE_AFTER_HOURS=24
# Local development only (ignored unless NODE_ENV is development/test):
# let endpoints point at localhost / private addresses.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=true
# A staging box that must accept http:// endpoint URLs.
# WEBHOOK_ALLOW_HTTP=true
